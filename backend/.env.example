# ──────────────────────────────────────────────
# LLM Provider Selection
# ──────────────────────────────────────────────
# Set to "ollama" (default) or "nvidia".
# When using "nvidia", NVIDIA_API_KEY must be set
# as a system environment variable (not in this file).
LLM_PROVIDER=ollama

# ──────────────────────────────────────────────
# Ollama Remote Server Configuration
# ──────────────────────────────────────────────
# Used when LLM_PROVIDER=ollama.
# Replace TEAMMATE_LAPTOP_IP with the actual IPv4 address.
# Example: OLLAMA_BASE_URL=http://192.168.1.100:11434

OLLAMA_BASE_URL=http://TEAMMATE_LAPTOP_IP:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_SECONDS=180

# ──────────────────────────────────────────────
# NVIDIA Build (NIM) Configuration
# ──────────────────────────────────────────────
# Used when LLM_PROVIDER=nvidia.
# NVIDIA_API_KEY should be set as a system environment variable.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ──────────────────────────────────────────────
# CORS — frontend origins (comma-separated)
# ──────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ──────────────────────────────────────────────
# ChromaDB Vector Store
# ──────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=product_manuals

# ──────────────────────────────────────────────
# PDF Upload Limits
# ──────────────────────────────────────────────
MAX_PDF_UPLOAD_SIZE_MB=20

# ──────────────────────────────────────────────
# Optional Vision Models
# ──────────────────────────────────────────────
# Leave blank to keep text-only mode.
# NVIDIA_VISION_MODEL=microsoft/phi-3-vision-128k-instruct
# OLLAMA_VISION_MODEL=llava

# ──────────────────────────────────────────────
# Image Upload Limits
# ──────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=5
MAX_IMAGE_WIDTH=2048
MAX_IMAGE_HEIGHT=2048
